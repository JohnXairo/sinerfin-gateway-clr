<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!-- Web API 2 core + OWIN adapter -->
  <package id="Microsoft.AspNet.WebApi.Core"   version="5.3.0" targetFramework="net48" />
  <package id="Microsoft.AspNet.WebApi.Client" version="5.3.0" targetFramework="net48" />
  <package id="Microsoft.AspNet.WebApi.Owin"   version="5.3.0" targetFramework="net48" />
  <package id="Microsoft.AspNet.WebApi.Cors"   version="5.3.0" targetFramework="net48" />
  <!-- OWIN self-host (HttpListener, sin IIS) -->
  <package id="Owin"                              version="1.0"   targetFramework="net48" />
  <package id="Microsoft.Owin"                    version="4.2.2" targetFramework="net48" />
  <package id="Microsoft.Owin.Host.HttpListener"  version="4.2.2" targetFramework="net48" />
  <package id="Microsoft.Owin.Hosting"            version="4.2.2" targetFramework="net48" />
  <package id="Microsoft.Owin.Cors"               version="4.2.2" targetFramework="net48" />
  <!-- TopShelf: instalar/desinstalar/correr como Windows Service con 1 comando -->
  <package id="Topshelf"                          version="4.3.0" targetFramework="net48" />
  <!-- JSON -->
  <package id="Newtonsoft.Json"                   version="13.0.3" targetFramework="net48" />
  <!-- Kafka -->
  <package id="Confluent.Kafka"                   version="2.4.0"  targetFramework="net48" />
  <!-- BCrypt -->
  <package id="BCrypt.Net-Next"                   version="4.0.3"  targetFramework="net48" />
</packages>
